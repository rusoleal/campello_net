# Doxyfile for campello_net

PROJECT_NAME           = "campello_net"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "C++20 multiplayer networking library for the Campello game engine"
OUTPUT_DIRECTORY       = docs/doxygen

# Input
INPUT                  = README.md \
                         AGENTS.md \
                         include/campello_net \
                         examples
FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO

# C++ specific
OPTIMIZE_OUTPUT_FOR_C  = NO
CPP_CLI_SUPPORT        = NO

# Warnings
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT

# Diagrams
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# Layout
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# Source browsing
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES

# Search
SEARCHENGINE           = YES
